/* ============================================================================
   Main Window and Dialogs
   ============================================================================ */
QMainWindow, QDialog {
    background-color: rgba(25, 25, 30, 0.85);
    color: #E0E0E6;
    font-family: "Segoe UI", "Helvetica Neue", Arial, sans-serif;
    font-size: 13px;
}

/* ============================================================================
   Labels and Text
   ============================================================================ */
QLabel {
    color: #E0E0E6;
    background: transparent;
}

QLabel#TrackTitle {
    font-size: 16px;
    font-weight: bold;
    color: #FFFFFF;
}

QLabel#ArtistName {
    font-size: 13px;
    color: #A0A0AA;
}

/* ============================================================================
   Buttons (Play, Pause, Skip, Icons)
   ============================================================================ */
QPushButton {
    background-color: rgba(255, 255, 255, 0.08);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    padding: 6px 12px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.2);
}

QPushButton:pressed {
    background-color: rgba(255, 255, 255, 0.05);
}

/* Accent Circle Button for Play/Pause */
QPushButton#PlayPauseButton {
    background-color: #1DB954; /* Spotify Green */
    color: #000000;
    border: none;
    border-radius: 20px; /* Adjust based on your widget size to keep it circular */
    padding: 10px;
}

QPushButton#PlayPauseButton:hover {
    background-color: #1ED760;
    transform: scale(1.05);
}

QPushButton#PlayPauseButton:pressed {
    background-color: #14833B;
}

/* ============================================================================
   Sliders (Progress Bar & Volume)
   ============================================================================ */
QSlider::groove:horizontal {
    border: none;
    height: 4px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 2px;
}

QSlider::sub-page:horizontal {
    background: #1DB954;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #FFFFFF;
    border: none;
    width: 12px;
    height: 12px;
    margin: -4px 0;
    border-radius: 6px;
}

QSlider::handle:horizontal:hover {
    background: #1ED760;
    width: 14px;
    height: 14px;
    margin: -5px 0;
    border-radius: 7px;
}

/* ============================================================================
   Playlist / Track List (QListWidget or QTreeView)
   ============================================================================ */
QListWidget, QTreeView {
    background-color: rgba(20, 20, 25, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    padding: 5px;
    color: #E0E0E6;
    show-decoration-selected: 1;
}

QListWidget::item, QTreeView::item {
    padding: 8px 10px;
    border-radius: 4px;
    background: transparent;
}

QListWidget::item:hover, QTreeView::item:hover {
    background-color: rgba(255, 255, 255, 0.08);
    color: #FFFFFF;
}

QListWidget::item:selected, QTreeView::item:selected {
    background-color: rgba(29, 185, 84, 0.25);
    color: #1DB954;
    font-weight: bold;
}

/* ============================================================================
   ScrollBars
   ============================================================================ */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.15);
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.3);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    background: none;
    height: 0px;
}

/* ============================================================================
   Volume / Sidebar Panels
   ============================================================================ */
QFrame#Sidebar {
    background-color: rgba(15, 15, 20, 0.4);
    border-right: 1px solid rgba(255, 255, 255, 0.05);
}
